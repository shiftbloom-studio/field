{
  "name": "field",
  "version": "1.0.0",
  "private": true,
  "description": "Intranet hub for a team on Cloudflare: health checks, uptime history and admin screens for all your Workers in one place.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply field-db --remote",
    "typecheck": "tsc -p .",
    "build": "wrangler deploy --dry-run --outdir .build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.10",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.50.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.29.1"
  }
}

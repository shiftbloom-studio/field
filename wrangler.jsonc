// field — Cloudflare Workers config.
// Self-hosting: create the D1 database (see README), put its id below, adjust APPS to your
// own services and point the service bindings at your Worker names. Bindings you don't
// have can simply be removed: the matching admin screen hides itself.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "field",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  // "routes": [{ "pattern": "field.example.com", "custom_domain": true }],

  "triggers": { "crons": ["*/5 * * * *"] },

  "d1_databases": [
    { "binding": "DB", "database_name": "field-db", "database_id": "<your-field-db-id>", "migrations_dir": "migrations" },
    // Read/write access to the apps' own databases, for stats and admin actions.
    { "binding": "DROP_DB", "database_name": "drop-db", "database_id": "<drop-db-id>" },
    { "binding": "CONVERT_DB", "database_name": "convert-db", "database_id": "<convert-db-id>" },
    { "binding": "GROW_DB", "database_name": "grow-cloud", "database_id": "<grow-db-id>" },
    { "binding": "ROOTS_DB", "database_name": "roots", "database_id": "<roots-db-id>" },
    // rhizome's control plane (clients and hashed API keys only, never memory content).
    { "binding": "RHIZOME_DB", "database_name": "rhizome-control", "database_id": "<rhizome-control-db-id>" },
    // leaf's pastes and API tokens (same api_tokens schema as drop, "leaf_" prefix).
    { "binding": "LEAF_DB", "database_name": "leaf-db", "database_id": "<leaf-db-id>" }
  ],
  "r2_buckets": [
    { "binding": "CONVERT_FILES", "bucket_name": "convert-files" },
    // Optional: lets the leaf admin screen delete pastes (text lives in R2).
    { "binding": "LEAF_PASTES", "bucket_name": "leaf-pastes" }
  ],
  "queues": { "producers": [{ "binding": "ROOTS_QUEUE", "queue": "roots-index" }] },

  // Health checks go through service bindings: no public round trip, no Access in the way.
  "services": [
    { "binding": "DROP", "service": "drop" },
    { "binding": "CONVERT", "service": "convert" },
    { "binding": "GROW", "service": "grow-cloud" },
    { "binding": "ROOTS", "service": "roots" },
    { "binding": "PETAL", "service": "petal" },
    { "binding": "RHIZOME", "service": "rhizome" },
    { "binding": "LEAF", "service": "leaf" },
    { "binding": "STEM", "service": "stem" },
    { "binding": "VA_WEB", "service": "va-dispatch-web" },
    { "binding": "VA_API", "service": "va-dispatch-api" }
  ],

  "vars": {
    // Cloudflare Access: your team domain and the AUD tag of the Access application in front of field.
    "ACCESS_TEAM_DOMAIN": "<your-team>.cloudflareaccess.com",
    "ACCESS_AUD": "<access-application-aud>",
    "ORG_NAME": "shiftbloom studio",
    "TZ": "Europe/Berlin",
    "RETENTION_DAYS": "30",
    "SOURCE_URL": "https://github.com/shiftbloom-studio/field",
    // Account watchers (optional, only run when the CF_API_TOKEN secret is set): Workers AI usage and Access changes.
    "CF_ACCOUNT_ID": "<your-account-id>",
    "AI_HOURLY_NEURONS": "2000000",
    "AI_DAILY_USD": "7",
    "ACCESS_WATCH_PRODUCTS": "access",
    // Shown on /imprint, /impressum, /privacy and /datenschutz. Required in the EU; fill in your own details.
    // "authority" is the data protection authority responsible for the operator's address.
    "OPERATOR": {
      "name": "<your name>",
      "business": "<business name, optional>",
      "street": "<street and number>",
      "city": "<postcode and city>",
      "country": { "en": "Germany", "de": "Deutschland" },
      "email": "<contact email>",
      "phone": "<phone number>",
      "authority": { "en": "<supervisory authority, address>", "de": "<Aufsichtsbehörde, Anschrift>" }
    },
    "APPS": [
      { "id": "drop", "name": "drop", "url": "https://drop.example.com", "blurb": "Files, pastes and short links", "service": "DROP", "health": "/health", "db": "DROP_DB", "adapter": "drop" },
      { "id": "convert", "name": "convert", "url": "https://convert.example.com", "blurb": "Converts images, video and audio", "service": "CONVERT", "health": "/api/health", "db": "CONVERT_DB", "adapter": "convert" },
      { "id": "grow", "name": "grow", "url": "https://grow.example.com", "blurb": "To-do overlays for OBS", "service": "GROW", "health": "/healthz", "db": "GROW_DB", "adapter": "grow" },
      // roots sits behind Access and answers 401 without a token: that still proves the Worker is up.
      { "id": "roots", "name": "roots", "url": "https://roots.example.com", "blurb": "Knowledge base over repos and docs", "service": "ROOTS", "health": "/", "expect": [401], "db": "ROOTS_DB", "adapter": "roots" },
      { "id": "petal", "name": "petal", "url": "https://chat.example.com", "blurb": "Twitch chat relay", "service": "PETAL", "health": "/health" },
      { "id": "rhizome", "name": "rhizome", "url": "https://rhizome.example.com", "blurb": "Long-term memory for AI agents", "service": "RHIZOME", "health": "/v1/health", "db": "RHIZOME_DB", "adapter": "rhizome" },
      { "id": "leaf", "name": "leaf", "url": "https://leaf.example.com", "blurb": "Pastebin with syntax highlighting", "service": "LEAF", "health": "/health", "db": "LEAF_DB", "adapter": "leaf" },
      { "id": "stem", "name": "stem", "url": "https://stem.example.com", "blurb": "Sign-in and accounts for the apps", "service": "STEM", "health": "/health" },
      { "id": "va-dispatcher", "name": "va dispatcher", "url": "https://www.va-dispatcher.example", "blurb": "Dispatch for virtual airlines", "service": "VA_WEB", "health": "/" },
      { "id": "va-dispatcher-api", "name": "va dispatcher api", "url": "https://www.va-dispatcher.example/api", "blurb": "API behind va dispatcher", "service": "VA_API", "health": "/health" }
    ],
    "LINKS": [
      { "name": "Cloudflare", "url": "https://dash.cloudflare.com", "note": "Dashboard" },
      { "name": "GitHub", "url": "https://github.com/shiftbloom-studio", "note": "All repositories" }
    ]
  }
  // Optional alert emails (Cloudflare Email Sending, the sender's domain must be onboarded):
  // "send_email": [{ "name": "ALERT_MAIL", "destination_address": "<you@example.com>" }],
  // plus vars "ALERT_EMAIL_FROM": "field <alerts@mail.example.com>" and "ALERT_EMAIL_TO": "<you@example.com>".
  // Optional secret: ALERT_WEBHOOK (Discord or Slack incoming webhook) → `npx wrangler secret put ALERT_WEBHOOK`
  // Optional secret: CF_API_TOKEN (read-only, see README) → `npx wrangler secret put CF_API_TOKEN`
}
